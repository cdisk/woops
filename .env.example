# Woops 环境变量（仓库根目录）
# 首次使用：复制本文件为 .env，再按本机改 PUBLIC 地址与 TLS pin
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 加载到当前 PowerShell：. .\scripts\load-env.ps1
# Docker full profile：compose 的 env_file 指向 .env（勿提交）
#
# 命名约定：
#   PUBLIC   = 浏览器 / Agent / woopsctl / 安装链接看到的地址（生产用 https / wss）
#   INTERNAL = 仅服务互调（明文 http，勿对公网暴露）

# ========== PUBLIC（给客户端看的地址）==========
# 谁用：浏览器 / Agent / woopsctl / 安装脚本。服务互调看下面 INTERNAL。
# scheme：Gateway 已挂自签证书 → PUBLIC 用 https/wss；INTERNAL 仍 http。

# control-api：浏览器 / GitLab 回调用
OPS_CONTROL_PUBLIC_HTTP=http://127.0.0.1:9100

# Gateway：Agent / 安装脚本 / woopsctl 用（须匹配 TLS 证书 SAN；可用域名或局域网 IP）
OPS_GATEWAY_PUBLIC_HTTP=https://127.0.0.1:9200

# Gateway：票据 browserWs 的基址。前端 session/sessionWs.js 的 rewriteWs 会把它改写成
# Console 同源，实际经 nginx /ws 反代到 Gateway INTERNAL，所以浏览器并不直连 9200；
# 9200 只服务 Agent / 安装脚本 / woopsctl（见上面的 PUBLIC_HTTP）。
OPS_GATEWAY_PUBLIC_WS=wss://127.0.0.1:9200

# 控制台（Vite 开发默认 https://127.0.0.1:5173；Docker 控制台多为 https://<host>）
OPS_CONSOLE_PUBLIC_HTTP=https://127.0.0.1:5173

# ========== INTERNAL（对内，服务互调）==========

# control-api → Gateway（portmap 等）；本机用 9201，Docker 内由 compose 覆盖为 http://gateway:9201
OPS_GATEWAY_INTERNAL_HTTP=http://127.0.0.1:9201

# Gateway → control-api；本机 / Docker 均用 9100
OPS_CONTROL_INTERNAL_HTTP=http://127.0.0.1:9100

# ========== Gateway 监听 ==========

# 对外监听（有 TLS 证书时为 HTTPS，否则开发态明文 HTTP）
OPS_GATEWAY_PUBLIC_LISTEN=:9200

# 对内明文 HTTP 监听（仅给 control-api，生产勿对公网映射）
OPS_GATEWAY_INTERNAL_LISTEN=:9201

# Agent 二进制目录（含 woops-agent-{os}-{arch}，供安装下载）
OPS_AGENT_BIN_DIR=bin

# ========== Gateway TLS（生产）==========
# 自签名证书与 SPKI pin：deploy/gen-gateway-tls.sh
# control-api 与 Gateway 必须使用同一个 pin

# 证书/私钥：请用绝对路径（Gateway 常从 go/ 启动，相对路径会找不到）
OPS_GATEWAY_TLS_CERT=
OPS_GATEWAY_TLS_KEY=

# SPKI pin（必须与上面证书一致；由 gen-gateway-tls.sh 打印）。Agent/安装脚本靠 pin，不靠系统 CA
OPS_GATEWAY_TLS_SPKI_SHA256=

# ========== 桌面会话 / guacd ==========
# 本机 Gateway + Docker guacd 时用下面默认值；全 Docker 时 compose 会改成 guacd:4822

# guacd 地址
OPS_GUACD_ADDR=127.0.0.1:4822

# guacd 回连本机 RDP/VNC 桥时用的主机名（Docker Desktop 常用 host.docker.internal）
OPS_GUAC_BRIDGE_HOST=host.docker.internal

# ========== control-api 密钥与初始管理员 ==========
# 生产务必改掉密钥与密码

OPS_JWT_SECRET=ops-dev-jwt-secret-change-me-please-32bytes
OPS_TICKET_SECRET=ops-dev-ticket-secret-change-me-32b
OPS_BOOTSTRAP_ADMIN_USERNAME=admin
OPS_BOOTSTRAP_ADMIN_PASSWORD=admin123

# ========== GitLab OAuth（可选）==========
# 下面三项齐备则启用 GitLab 登录，并关闭本地账密登录
# OPS_GITLAB_BASE_URL=https://gitlab.example.com
# OPS_GITLAB_CLIENT_ID=
# OPS_GITLAB_CLIENT_SECRET=
# 推荐经 Console HTTPS 反代（须与 GitLab Application 回调完全一致）
# OPS_GITLAB_REDIRECT_URI=https://console.example.com/api/auth/gitlab/callback
# 登录后升为 SUPER_ADMIN 的 GitLab 用户名（逗号分隔）
# OPS_GITLAB_ADMIN_USER=admin
# Scope：仅 read_user
