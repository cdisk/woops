# syntax=docker/dockerfile:1
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY deploy/maven-settings.xml /root/.m2/settings.xml
COPY apps/control-api/pom.xml .
# Warm dependency layer (cached across rebuilds when pom.xml unchanged).
# BuildKit cache mount keeps ~/.m2 between builds even when layers invalidate.
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -q -B -DskipTests dependency:go-offline
COPY apps/control-api/src ./src
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -q -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/control-api-0.1.0-SNAPSHOT.jar app.jar
EXPOSE 9100
ENTRYPOINT ["java","-jar","/app/app.jar"]
