# Production example — copy to /opt/ops/.env on the server (do not commit real secrets).
# Gateway uses network_mode: host — INTERNAL/GUAC addresses are host loopback / host-gateway.
# Replace example.com / 192.0.2.10 with your public hostname and LAN IP.

# ========== PUBLIC ==========
OPS_CONTROL_PUBLIC_HTTP=http://192.0.2.10:9100
OPS_GATEWAY_PUBLIC_HTTP=https://gateway.example.com:9200
OPS_GATEWAY_PUBLIC_WS=wss://gateway.example.com:9200
OPS_CONSOLE_PUBLIC_HTTP=https://192.0.2.10

# ========== INTERNAL (host-network gateway; compose environment matches) ==========
# Bridge services reach gateway via host.docker.internal (see compose extra_hosts).
OPS_GATEWAY_INTERNAL_HTTP=http://host.docker.internal:9201
OPS_CONTROL_INTERNAL_HTTP=http://127.0.0.1:9100

OPS_GATEWAY_PUBLIC_LISTEN=:9200
OPS_GATEWAY_INTERNAL_LISTEN=:9201
OPS_AGENT_BIN_DIR=/app/bin

# TLS inside container (mounted from deploy/tls)
OPS_GATEWAY_TLS_CERT=/tls/gateway.crt
OPS_GATEWAY_TLS_KEY=/tls/gateway.key
# Filled after gen-gateway-tls.sh on deploy
OPS_GATEWAY_TLS_SPKI_SHA256=

# guacd publishes 4822 to host; guacd container dials bridge via host.docker.internal
OPS_GUACD_ADDR=127.0.0.1:4822
OPS_GUAC_BRIDGE_HOST=host.docker.internal

OPS_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes!!
OPS_TICKET_SECRET=CHANGE_ME_ticket_secret_32_bytes!
OPS_BOOTSTRAP_ADMIN_USERNAME=admin
OPS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ========== GitLab OAuth（可选）==========
# 三项齐备则启用并关闭本地登录。Secret 只写服务器 .env，勿提交。
# OPS_GITLAB_BASE_URL=https://gitlab.example.com
# OPS_GITLAB_CLIENT_ID=
# OPS_GITLAB_CLIENT_SECRET=
# OPS_GITLAB_REDIRECT_URI=https://console.example.com/api/auth/gitlab/callback
# OPS_GITLAB_ADMIN_USER=admin
# Scope：仅 read_user
